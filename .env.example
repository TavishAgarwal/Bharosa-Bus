# Paths (defaults shown)
TICKETS_CSV=data/raw/October-Delhi.csv
GTFS_DIR=data/raw/gtfs
GPS_DIR=data/raw/gps            # optional: 2-3 extracted bus_movements_YYYY_MM_DD.db files
OUT_DIR=data/out

# Model knobs (see docs/METHOD.md once written)
MIN_TICKETS_PER_CELL=30         # below this the UI shows "insufficient evidence"
BOOTSTRAP_SAMPLES=500
SAMPLE_RATE_LOW=0.03             # share of all bus tickets in the dataset (event page: 3-4%)
SAMPLE_RATE_HIGH=0.04
PASS_HOLDER_UPLIFT_LOW=1.0      # assumption range, not a fact
PASS_HOLDER_UPLIFT_HIGH=1.6
# Bus capacity sets: fill from DTC/DIMTS sources. Placeholders only, UNSOURCED.
CAPACITY_SEATS=
CAPACITY_STANDING=

OBSERVED_TRIPS=1                # 1 = use buses seen on tickets as a floor for trip counts, 0 = scheduled only
